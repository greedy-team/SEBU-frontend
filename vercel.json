{
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "sebu-frontend.vercel.app" }],
      "destination": "https://www.sebu.kr/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.sebu.kr/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
