# MSW(가짜 서버) 사용 여부
#   true  : MSW가 응답 (백엔드 없이 개발)
#   false : 아래 주소의 백엔드로 요청
VITE_USE_MSW=true

# vite 프록시가 /api 요청을 넘길 대상. VITE_USE_MSW=false일 때만 씁니다.
#   로컬 도커 : http://localhost:8080
#   개발 서버 : https://sebu-dev-api.duckdns.org
VITE_API_PROXY_TARGET=http://localhost:8080

# 사용자 행동 분석 (Microsoft Clarity / Hotjar).
# 비워두면 해당 도구는 로드하지 않습니다. 프로덕션 빌드(vite build)에서만 동작하고
# 로컬 dev 서버에서는 절대 로드되지 않습니다.
VITE_CLARITY_ID=
VITE_HOTJAR_ID=
